# ZiadaPOS MCP agent — environment configuration
# Copy to .env and adjust. Never commit real secrets.

# ZiadaPOS API (the Go backend this agent talks to)
ZIADA_API_URL=http://localhost:8080/api/v1

# The shop owner / service account the agent logs in as.
ZIADA_IDENTIFIER=
ZIADA_PASSWORD=
# Optional: force a specific store (defaults to the account's current store).
ZIADA_STORE_ID=

# Ngamia AI gateway (OpenAI-compatible)
NGAMIA_BASE_URL=https://api.ngamia.cc/v1
NGAMIA_API_KEY=ngm_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NGAMIA_MODEL=openai/gpt-4o-mini

# Agent behaviour
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_SECONDS=120

# SendAfrica SMS (agent sends SMS directly, same as the API)
SENDAFRICA_BASE_URL=https://api.sendafrica.online
SENDAFRICA_API_KEY=SA-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDAFRICA_SENDER_ID=SendAfrika

# MailAfrica email (agent sends email directly, same as the API)
MAILAFRICA_BASE_URL=https://api.mailafrica.online
MAILAFRICA_API_KEY=MAIL_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAILAFRICA_FROM_DOMAIN=yourdomain.com
MAILAFRICA_FROM_ADDRESS=noreply@yourdomain.com
MAILAFRICA_FROM_NAME=ZiadaPOS

# MCP transport: http | stdio
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8081

LOG_LEVEL=info
