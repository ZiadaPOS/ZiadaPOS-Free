# ZiadaPOS API — environment configuration
# Copy to .env and adjust. Never commit real secrets.

# App
APP_ENV=development
DEBUG=true
PORT=8080
API_BASE_PATH=/api/v1
SITE_URL=http://localhost:3000
APP_TIMEZONE=Africa/Dar_es_Salaam

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=ziada
DB_PASSWORD=ziada
DB_NAME=ziada
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=5m

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ziada
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
PUBLIC_BASE_URL=http://localhost:9000/ziada

# JWT
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# SMTP (email) — Zoho recommended
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ziadapos.com
SMTP_FROM_NAME=ZiadaPOS

# SendAfrica SMS
SENDAFRICA_BASE_URL=https://api.sendafrica.online
SENDAFRICA_API_KEY=SA-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDAFRICA_SENDER_ID=SendAfrika

# Ngamia AI (OpenAI-compatible gateway)
NGAMIA_BASE_URL=https://api.ngamia.cc/v1
NGAMIA_API_KEY=ngm_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NGAMIA_MODEL=openai/gpt-4o-mini

# Scheduler
DAILY_REPORT_HOUR=22
DAILY_REPORT_MINUTE=0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:1420,http://localhost:5173
